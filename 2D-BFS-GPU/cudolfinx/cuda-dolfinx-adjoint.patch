+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""cudolfinx.adjoint: discrete adjoints for GPU-assembled DOLFINx problems.
+
+Built on `pyadjoint <https://github.com/dolfin-adjoint/pyadjoint>`_ (the tape used by
+dolfin-adjoint). Forward solves, adjoint solves and gradient assembly all run on the GPU
+through cuDOLFINx; Constants are differentiated through a real element on the CPU.
+
+Minimal example::
+
+    from cudolfinx import adjoint as ad
+    u = ad.Function(V)
+    f = ad.Function(V); f.interpolate(...)
+    problem = ad.LinearProblem(a, L, u, bcs, petsc_options={...})
+    problem.solve()
+    J = ad.assemble_scalar(u**2 * ufl.dx)
+    rf = ad.ReducedFunctional(J, ad.Control(f))
+    dJdf = rf.derivative()
+    ad.taylor_test(rf, f, h)        # should report rate 2
+
+Not yet available: Hessians / tangent-linear models, derivatives with respect to mesh
+coordinates, Expressions as controls, and MPI-parallel runs (serial only).
+"""
+
+from pyadjoint import (
+    AdjFloat,
+    Control,
+    ReducedFunctional,
+    compute_gradient,
+    get_working_tape,
+    minimize,
+    pause_annotation,
+    continue_annotation,
+    set_working_tape,
+    stop_annotating,
+    taylor_test,
+)
+
+from pyadjoint.tape import Tape
+
+if get_working_tape() is None:          # pyadjoint has no default tape; dolfin-adjoint creates one on import
+    set_working_tape(Tape())
+continue_annotation()                   # pyadjoint records nothing until annotation is switched on
+
+from .assembly import AssembleBlock, assemble_scalar, assign
+from .solving import LinearProblem, NonlinearProblem, SolveBlock
+from .types import Constant, Function
+from .timeloop import linear_time_loop
+from . import affine, gpu
+
+__all__ = [
+    "AdjFloat", "Control", "ReducedFunctional", "compute_gradient", "get_working_tape", "minimize",
+    "pause_annotation", "continue_annotation", "set_working_tape", "stop_annotating", "taylor_test",
+    "Function", "Constant", "LinearProblem", "NonlinearProblem", "assemble_scalar", "assign",
+    "SolveBlock", "AssembleBlock", "gpu", "linear_time_loop",
+]
+
+
+def stats() -> dict:
+    """Counters: compiled CUDA forms, GPU assemblies, adjoint solves, CPU constant derivatives."""
+    from . import affine
+    from . import timeloop
+    return dict(gpu.STATS, **affine.STATS, **timeloop.STATS)
diff --git a/python/cudolfinx/adjoint/affine.py b/python/cudolfinx/adjoint/affine.py
