+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""A whole linear, constant-operator time loop as ONE tape block, run on the GPU.
+
+    for n in range(N):                      # the usual pattern: 2N tape blocks, a host copy and
+        problem.solve()                     # a checkpoint per step, a Python-level adjoint
+        ad.assign(c_n, c)                   # replay of every block
+    ->
+    ad.linear_time_loop(problem, c_n, N)    # one block; the states stay on the device
+
+Requirements (checked): ``problem`` is a :class:`LinearProblem` for ``c`` whose bilinear form
+does not contain ``c_n``, whose linear form is affine in ``c_n``, and whose Dirichlet values are
+not recorded Functions; the other coefficients and Constants are constant during the loop.
+
+Forward, with Z the projection that zeroes the Dirichlet rows and D = ∂F/∂c_n
+(F = a(c) - L(c_n)):
+
+    x_0 = c_n,   A x_{k+1} = v0 - Z D x_k,   v0 = L(c_n = 0) with lifting and Dirichlet values
+
+one sparse matrix-vector product, one vector update and one solve per step, all on CUDA
+vectors; the trajectory x_0 .. x_N is kept on the device (it is needed by the gradient with
+respect to coefficients the step depends on through the states, e.g. a velocity field).
+
+Adjoint, for the input y_N = dJ/dx_N (sum over the two outputs c and c_n):
+
+    λ_k = A^{-T} Z y_{k+1},   y_k = -D^T λ_k,
+    dJ/dm += -(∂F/∂m)^T λ_k  at (c, c_n) = (x_{k+1}, x_k)      for every other dependency m
+
+with the gradient forms assembled on the device from coefficients copied device-to-device,
+and accumulated on the device. Constants: the DG0 stand-in of gpu.constant_derivative,
+accumulated over the steps and summed once.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+from petsc4py import PETSc
+
+import ufl
+from dolfinx import fem
+from pyadjoint import Block
+from pyadjoint.tape import annotate_tape, get_working_tape, stop_annotating
+
+from cudolfinx.la import CUDAVector
+
+from . import gpu
+from .types import Constant, Function, from_cpp
+
+STATS = {"fused_loops": 0, "fused_forward_steps": 0, "fused_adjoint_steps": 0}
+
+
+def _owned(V):
+    return gpu.owned(V)
+
+
+class _Loop:
+    """The device-side machinery of one (problem, c_n) pair: matrices, vectors, forms."""
+
+    def __init__(self, problem, c_n):
+        self.P, self.c_n = problem, c_n
+        self.c = problem.u
+        self.V = self.c.function_space
+        P = problem
+        if any(c is c_n for c in P.a.coefficients()):
+            raise ValueError("linear_time_loop: the bilinear form must not depend on c_n")
+        for bc in P.bcs:
+            if isinstance(from_cpp(bc.g) if not isinstance(bc.g, Function) else bc.g, Function):
+                raise NotImplementedError("linear_time_loop: Dirichlet values that are recorded Functions")
+        trial = ufl.TrialFunction(self.V)
+        self.D_form = ufl.derivative(P.F, c_n, trial)                 # = -∂L/∂c_n, constant in c_n
+        from .affine import _is_zero_form
+        if not _is_zero_form(ufl.derivative(self.D_form, c_n, trial)):
+            raise ValueError("linear_time_loop: the linear form must be affine in c_n")
+        self.ctx = P.asm._ctx
+        tmpl = P.x
+        self.mask = tmpl.duplicate()
+        m = np.ones(_owned(self.V))
+        if P.bcs:
+            m[P_bc_dofs(P)] = 0.0
+        self.mask.setArray(m)
+        self.v0, self.r, self.rhs = tmpl.duplicate(), tmpl.duplicate(), tmpl.duplicate()
+        self.traj: list[PETSc.Vec] = []
+        self.traj_values = None
+        # three coefficient carriers for the per-step gradient forms (device-to-device)
+        self.lam = gpu.work_function(self.V, "loop_adjoint")
+        self.carrier = {}
+        for f in (self.c, self.c_n, self.lam):
+            v = tmpl.duplicate()
+            self.carrier[id(f)] = (f, v, CUDAVector(self.ctx, v))
+
+    # -------------------------------------------------------------- operators at live values
+    def operators(self):
+        P = self.P
+        P._ensure_matrix()
+        Dm, D = gpu.assemble_matrix(self.D_form, [], P.jit_options)
+        self.D = D
+        # v0 = L(c_n = 0) with lifting and Dirichlet values, exactly as LinearProblem._forward
+        with gpu.substituted({self.c_n: np.zeros_like(self.c_n.x.array)}):
+            P.asm.assemble_vector(P.cuda_L, P.b)
+            if P.bcs:
+                P.device_bcs.update()
+                if not gpu.bc_values_zero(P.bcs):
+                    P.asm.apply_lifting(P.b, [P.cuda_a], [P.device_bcs])
+                P.asm.set_bc(P.b, bcs=P.device_bcs, V=self.V)
+            P.b.vector.copy(self.v0)
+
+    def forward(self, steps):
+        """Run the loop from the live c_n; keeps the trajectory; returns the final state (host)."""
+        self.operators()
+        n = _owned(self.V)
+        for v in self.traj:
+            v.destroy()
+        x = self.P.x.duplicate()
+        x.setArray(self.c_n.x.array[:n])
+        self.traj = [x]
+        ksp = self.P.ksp
+        for k in range(steps):
+            self.D.mult(x, self.r)                       # r = D x_k
+            self.r.pointwiseMult(self.r, self.mask)      # Z D x_k
+            self.v0.copy(self.rhs)
+            self.rhs.axpy(-1.0, self.r)                  # v0 - Z D x_k
+            xn = x.duplicate()
+            ksp.solve(self.rhs, xn)
+            self.traj.append(xn)
+            x = xn
+        STATS["fused_forward_steps"] += steps
+        self.traj_values = self.snapshot()
+        return x.getArray(readonly=True).copy()
+
+    def snapshot(self):
+        """Live values of everything the trajectory depends on (not the evolving state c)."""
+        out = []
+        for f in tuple(self.P.F.coefficients()) + tuple(self.P.F.constants()):
+            if f is self.c:
+                continue
+            out.append(f.x.array.copy() if isinstance(f, fem.Function) else np.array(f.value, copy=True))
+        return out
+
+    # -------------------------------------------------------------- adjoint
+    def _set_carriers(self, cf, pairs):
+        for f, vec in pairs:
+            ff, carrier, cv = self.carrier[id(f)]
+            vec.copy(carrier)
+            cf.update_coefficient_from_vector(f, cv)
+
+    def adjoint(self, y_host, deps, steps):
+        """deps: list of (object, kind) with kind in {"function", "constant"}; returns
+        {id(object): gradient array} and the adjoint w.r.t. the initial c_n."""
+        P = self.P
+        n = _owned(self.V)
+        dFdu_adj = gpu.derived(P.F, "dFdu_adj", lambda: ufl.adjoint(ufl.derivative(P.F, self.c, ufl.TrialFunction(self.V))))
+        fwd = P.adjoint_solver() if gpu.CONFIG["reuse_forward_operator"] else None
+        if fwd is not None:
+            ksp_adj, transpose = fwd
+        else:
+            _, ksp_adj, _ = gpu.adjoint_operator(dFdu_adj, P.bcs, P.adjoint_options, P.adjoint_prefix, P.jit_options)
+            transpose = False
+        y = self.P.x.duplicate()
+        y.setArray(np.asarray(y_host)[:n])
+        lam = y.duplicate()
+        # gradient forms and accumulators
+        terms = []
+        for obj, kind in deps:
+            if kind == "function":
+                form = gpu.derived(P.F, ("loop_dFdm_adj_lam", id(obj)), lambda obj=obj: ufl.action(
+                    ufl.adjoint(ufl.derivative(P.F, obj, ufl.TrialFunction(obj.function_space))), self.lam))
+                stand_in = None
+            else:
+                stand_in = gpu.constant_stand_in(obj, self.V.mesh)
+                pairing = gpu.derived(P.F, "loop_pairing", lambda: ufl.action(P.F, self.lam))
+                form = gpu.derived(pairing, ("d_constant", id(obj)), lambda obj=obj, s=stand_in, pr=pairing: ufl.derivative(
+                    ufl.replace(pr, {obj: s}), s, ufl.TestFunction(s.function_space)))
+            cf = gpu.cuda_form(form, P.jit_options)
+            cf.to_device()                                  # every coefficient at the recorded values
+            P.asm.pack_coefficients(cf)
+            vec = P.asm.create_vector(cf)
+            acc = vec.vector.duplicate()
+            acc.set(0.0)
+            # the compiled form keeps only the coefficients that survive differentiation
+            from ufl.algorithms import expand_derivatives
+            used = expand_derivatives(form).coefficients()
+            present = [f for f in (self.c, self.c_n, self.lam) if any(f is g for g in used)]
+            terms.append((obj, kind, form, cf, vec, acc, present))
+        for k in range(steps - 1, -1, -1):
+            y.pointwiseMult(y, self.mask)                   # λ = 0 on Dirichlet dofs
+            if transpose:
+                ksp_adj.solveTranspose(y, lam)
+            else:
+                ksp_adj.solve(y, lam)
+            src = {id(self.c): self.traj[k + 1], id(self.c_n): self.traj[k], id(self.lam): lam}
+            for obj, kind, form, cf, vec, acc, present in terms:
+                self._set_carriers(cf, [(f, src[id(f)]) for f in present])
+                P.asm.assemble_vector(cf, vec, coeffs=present, copy_to_device=False)
+                acc.axpy(-1.0, vec.vector)
+            self.D.multTranspose(lam, y)                    # y_k = -D^T λ_k
+            y.scale(-1.0)
+        STATS["fused_adjoint_steps"] += steps
+        out = {}
+        for obj, kind, form, cf, vec, acc, present in terms:
+            a = acc.getArray(readonly=True).copy()
+            if kind == "constant":
+                ncomp = max(1, int(np.prod(np.shape(obj.value))) or 1)
+                a = np.asarray(self.V.mesh.comm.allreduce(a.reshape(-1, ncomp).sum(axis=0))).reshape(np.shape(obj.value))
+            out[id(obj)] = a
+            acc.destroy()
+        y_initial = y.getArray(readonly=True).copy()
+        for v in (y, lam):
+            v.destroy()
+        return out, y_initial
+
+
+def P_bc_dofs(P):
+    return np.unique(np.concatenate([bc.dof_indices()[0] for bc in P.bcs])) if P.bcs else np.zeros(0, np.int32)
+
+
+class LinearTimeLoopBlock(Block):
+    def __init__(self, loop: _Loop, steps: int):
+        super().__init__()
+        self.loop, self.steps = loop, steps
+        P = loop.P
+        self.deps = []
+        seen = set()
+        for c in tuple(P.F.coefficients()) + tuple(P.F.constants()):
+            if c is loop.c or id(c) in seen or c is loop.lam:
+                continue
+            if isinstance(c, (Function, Constant)):
+                seen.add(id(c))
+                self.add_dependency(c, no_duplicates=True)
+                self.deps.append(c)
+        if loop.c_n not in self.deps:
+            self.add_dependency(loop.c_n, no_duplicates=True)
+            self.deps.append(loop.c_n)
+
+    def _values(self, inputs):
+        vals = {}
+        for bv, inp in zip(self.get_dependencies(), inputs):
+            obj = bv.output
+            if isinstance(obj, fem.Function):
+                vals[obj] = inp.x.array if isinstance(inp, fem.Function) else np.asarray(inp)
+            else:
+                vals[obj] = inp.value if isinstance(inp, fem.Constant) else np.asarray(inp)
+        vals[self.loop.c] = self.loop.c.x.array.copy()     # restored after a replay
+        return vals
+
+    def _trajectory_current(self, values):
+        L = self.loop
+        if L.traj_values is None or len(L.traj) != self.steps + 1:
+            return False
+        with gpu.substituted(values):
+            now = L.snapshot()
+        return len(now) == len(L.traj_values) and all(
+            a.shape == b.shape and np.array_equal(a, b) for a, b in zip(now, L.traj_values))
+
+    def prepare_evaluate_adj(self, inputs, adj_inputs, relevant_dependencies):
+        L = self.loop
+        values = self._values(inputs)
+        n = _owned(L.V)
+        y = np.zeros(n)
+        for a in adj_inputs:
+            if a is not None:
+                y += np.asarray(a.x.array if isinstance(a, fem.Function) else a)[:n]
+        with gpu.substituted(values):
+            if not self._trajectory_current(values):
+                L.forward(self.steps)                       # the tape was replayed elsewhere
+            else:
+                L.operators()
+            deps = []
+            for idx, bv in relevant_dependencies:
+                obj = bv.output
+                if obj is L.c_n:
+                    continue
+                deps.append((obj, "function" if isinstance(obj, fem.Function) else "constant"))
+            grads, y0 = L.adjoint(y, deps, self.steps)
+        grads[id(L.c_n)] = y0
+        return grads
+
+    def evaluate_adj_component(self, inputs, adj_inputs, block_variable, idx, prepared=None):
+        return prepared.get(id(block_variable.output))
+
+    def prepare_recompute_component(self, inputs, relevant_outputs):
+        values = self._values(inputs)
+        with gpu.substituted(values):
+            with stop_annotating():
+                xN = self.loop.forward(self.steps)
+        return xN
+
+    def recompute_component(self, inputs, block_variable, idx, prepared):
+        out = block_variable.output._ad_init_zero()
+        n = _owned(self.loop.V)
+        out.x.array[:n] = prepared
+        out.x.scatter_forward()
+        return out
+
+
+_LOOPS: dict = {}
+
+
+def linear_time_loop(problem, c_n: Function, steps: int, annotate=None) -> Function:
+    """Run ``steps`` steps of ``problem.solve(); assign(c_n, problem.u)`` on the GPU as one
+    tape block. Afterwards ``problem.u`` and ``c_n`` both hold the final state (as after the
+    explicit loop). Returns ``problem.u``."""
+    key = (id(problem), id(c_n))
+    hit = _LOOPS.get(key)
+    if hit is None:
+        hit = (_Loop(problem, c_n), problem, c_n)
+        _LOOPS[key] = hit
+    loop = hit[0]
+    annotate = annotate_tape({"annotate": annotate} if annotate is not None else None)
+    block = None
+    if annotate:
+        block = LinearTimeLoopBlock(loop, steps)
+        get_working_tape().add_block(block)
+    xN = loop.forward(steps)
+    n = _owned(loop.V)
+    for f in (loop.c, c_n):
+        f.x.array[:n] = xN
+        f.x.scatter_forward()
+    if annotate:
+        block.add_output(loop.c.create_block_variable())
+        block.add_output(c_n.create_block_variable())
+    STATS["fused_loops"] += 1
+    return loop.c
+
+
+def clear():
+    for loop, _, _ in _LOOPS.values():
+        for v in loop.traj:
+            v.destroy()
+        loop.traj = []
+    _LOOPS.clear()
