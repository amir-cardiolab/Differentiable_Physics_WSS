@@ -0,0 +1,428 @@
+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""GPU helpers shared by the adjoint blocks: one assembler, a cache of compiled CUDA forms
+keyed by form structure *and* coefficient identity (an adjoint sweep over a time loop
+re-uses one compiled form for thousands of blocks), GPU vector/matrix assembly returning
+host arrays / PETSc CUDA matrices, and the Constant derivative through a real element."""
+
+from __future__ import annotations
+
+import contextlib
+import os
+import typing
+
+import numpy as np
+from petsc4py import PETSc
+
+import basix.ufl
+import ufl
+from dolfinx import fem
+
+import cudolfinx as cufem
+
+_ASSEMBLER: cufem.CUDAAssembler | None = None
+_FORMS: dict[tuple, cufem.CUDAForm] = {}
+_VECTORS: dict[int, cufem.CUDAVector] = {}          # function space id -> work vector
+_MATRICES: dict[tuple, typing.Any] = {}              # form key -> CUDAMatrix
+_BCS: dict[tuple, typing.Any] = {}                   # ids of bcs -> packed device bcs
+# reuse_forward_operator: solve the adjoint of a linear problem with the forward matrix and its
+# preconditioner / factorisation when that is exact (see LinearProblem.adjoint_solver).
+CONFIG = {"reuse_forward_operator": os.environ.get("CUDOLFINX_ADJOINT_REUSE_FORWARD", "1") != "0",
+          # linear forms affine in their changing coefficients: matrices once, SpMV afterwards
+          "affine_replay": os.environ.get("CUDOLFINX_ADJOINT_AFFINE", "1") != "0"}
+STATS = {"compiled_forms": 0, "gpu_vector_assemblies": 0, "gpu_matrix_assemblies": 0,
+         "adjoint_solves": 0, "adjoint_operator_reused": 0, "forward_operator_reused": 0,
+         "liftings_skipped": 0,
+         "constant_derivatives": 0,
+         "cpu_constant_derivatives": 0}
+
+
+def assembler() -> cufem.CUDAAssembler:
+    global _ASSEMBLER
+    if _ASSEMBLER is None:
+        _ASSEMBLER = cufem.CUDAAssembler()
+    return _ASSEMBLER
+
+
+def _key(form: ufl.Form) -> tuple:
+    """Identity of a form: UFL's signature renumbers coefficients, constants AND the domain, so
+    the objects themselves (kept alive by the cache entries) must be part of the key."""
+    return ((form.signature(), id(form.ufl_domain().ufl_cargo()))
+            + tuple(id(c) for c in form.coefficients()) + tuple(id(c) for c in form.constants()))
+
+
+def cuda_form(form: ufl.Form, jit_options: dict | None = None) -> cufem.CUDAForm:
+    """Compiled CUDA form for `form`; compiled once per (structure, coefficient objects)."""
+    key = _key(form)
+    cf = _FORMS.get(key)
+    if cf is None:
+        cf = cufem.form(form, cuda_jit_args=jit_options or {})
+        # keep the UFL form, its coefficients, constants and mesh alive: their ids are in the key
+        cf._adjoint_keep = (form, form.ufl_domain().ufl_cargo(), tuple(form.coefficients()), tuple(form.constants()))
+        _FORMS[key] = cf
+        STATS["compiled_forms"] += 1
+    return cf
+
+
+_DERIVED: dict[tuple, tuple] = {}
+
+
+def derived(owner: ufl.Form, tag, build: typing.Callable[[], ufl.Form]) -> ufl.Form:
+    """A UFL form derived from `owner` (a derivative, an adjoint action, ...), built once.
+
+    A time loop records thousands of blocks on the same form; the symbolic work of
+    ufl.derivative / ufl.adjoint / ufl.action and the form signature would otherwise be redone
+    for each of them. Looked up by the owner's identity first, then by its structural key (the
+    same form re-created inside a loop)."""
+    k = (id(owner), tag)
+    hit = _DERIVED.get(k)
+    if hit is None:
+        ks = (_key(owner), tag)
+        hit = _DERIVED.get(ks)
+        if hit is None:
+            hit = (build(), owner)                   # keep the owner alive: its id is in the key
+            _DERIVED[ks] = hit
+        _DERIVED[k] = (hit[0], owner)
+    return hit[0]
+
+
+def pack_bcs(bcs) -> typing.Any:
+    key = tuple(id(bc) for bc in bcs)
+    packed = _BCS.get(key)
+    if packed is None:
+        packed = assembler().pack_bcs(list(bcs))
+        packed._adjoint_bcs = list(bcs)
+        _BCS[key] = packed
+    return packed
+
+
+def bc_values_zero(bcs) -> bool:
+    """True if every Dirichlet value is identically zero: the lifting b -= A g then vanishes
+    and need not be assembled (it costs a full cell loop of the bilinear form)."""
+    for bc in bcs:
+        g = bc.g
+        try:
+            if hasattr(g, "x"):
+                arr = g.x.array
+            elif hasattr(g, "value"):
+                arr = np.asarray(g.value)
+            else:
+                arr = np.asarray(g)
+        except Exception:
+            return False
+        if np.any(arr):
+            return False
+    return True
+
+
+_FUNCTIONS: dict[int, fem.Function] = {}            # function space id -> reusable Function
+
+
+def work_function(V, tag: str = "adjoint"):
+    """One reusable Function per (space, tag): forms built on it keep their compiled kernels."""
+    key = (id(V), tag)
+    f = _FUNCTIONS.get(key)
+    if f is None:
+        f = fem.Function(V, name=tag)
+        f._adjoint_space = V
+        _FUNCTIONS[key] = f
+    return f
+
+
+def work_vector(cf: cufem.CUDAForm) -> cufem.CUDAVector:
+    V = cf.function_spaces[0]
+    vec = _VECTORS.get(id(V))
+    if vec is None:
+        vec = assembler().create_vector(cf)
+        vec._adjoint_space = V
+        _VECTORS[id(V)] = vec
+    return vec
+
+
+def assemble_vector(form: ufl.Form, jit_options=None) -> np.ndarray:
+    """Assemble a linear form on the GPU; returns the owned entries as a numpy array."""
+    cf = cuda_form(form, jit_options)
+    vec = work_vector(cf)
+    assembler().assemble_vector(cf, vec)
+    STATS["gpu_vector_assemblies"] += 1
+    return vec.vector.getArray(readonly=True).copy()
+
+
+def assemble_matrix(form: ufl.Form, bcs, jit_options=None):
+    """Assemble a bilinear form on the GPU with Dirichlet rows/columns zeroed and unit
+    diagonal (DOLFINx's convention). Returns (CUDAMatrix, PETSc Mat)."""
+    cf = cuda_form(form, jit_options)
+    key = _key(form)
+    mat = _MATRICES.get(key)
+    if mat is None:
+        mat = assembler().create_matrix(cf)
+        _MATRICES[key] = mat
+    assembler().assemble_matrix(cf, mat, bcs=pack_bcs(bcs) if bcs else [])
+    mat.assemble()
+    mat.mat.assemble()
+    STATS["gpu_matrix_assemblies"] += 1
+    return mat, mat.mat
+
+
+_OPERATORS: dict[tuple, dict] = {}       # form key -> {"values", "mat", "ksp"}
+
+
+def coefficient_values(form: ufl.Form, bcs=None) -> list:
+    """Copies of the values a matrix assembled from `form` depends on (coefficients,
+    Constants, Dirichlet dof sets)."""
+    out = []
+    for c in tuple(form.coefficients()) + tuple(form.constants()):
+        if isinstance(c, fem.Function):
+            out.append(c.x.array.copy())
+        elif isinstance(c, fem.Constant):
+            out.append(np.array(c.value, copy=True))
+    for bc in bcs or []:
+        out.append(np.asarray(bc.dof_indices()[0]).copy())
+    return out
+
+
+def coefficient_values_unchanged(stored: list | None, form: ufl.Form, bcs=None) -> bool:
+    """True if the live values equal `stored` (a plain comparison: ~10x cheaper than hashing,
+    and a few tenths of a millisecond for 10^5 dofs)."""
+    if stored is None:
+        return False
+    live = []
+    for c in tuple(form.coefficients()) + tuple(form.constants()):
+        if isinstance(c, fem.Function):
+            live.append(c.x.array)
+        elif isinstance(c, fem.Constant):
+            live.append(np.asarray(c.value))
+    for bc in bcs or []:
+        live.append(np.asarray(bc.dof_indices()[0]))
+    if len(live) != len(stored):
+        return False
+    return all(a.shape == b.shape and np.array_equal(a, b) for a, b in zip(live, stored))
+
+
+def adjoint_operator(form: ufl.Form, bcs, options: dict, prefix: str, jit_options=None):
+    """Assembled adjoint operator A (GPU, Dirichlet rows/cols zeroed) and a KSP set up on it.
+
+    Cached per form structure: if the coefficient values are the ones the cached matrix was
+    built from (a time loop whose operator does not change), neither the assembly nor the
+    preconditioner / factorisation set-up is repeated. Returns (PETSc Mat, KSP, reused)."""
+    cf = cuda_form(form, jit_options)
+    key = _key(form)
+    entry = _OPERATORS.get(key)
+    if entry is not None and coefficient_values_unchanged(entry["values"], form, bcs):
+        return entry["mat"].mat, entry["ksp"], True
+    if entry is None:
+        mat = assembler().create_matrix(cf)
+        comm = form.ufl_domain().ufl_cargo().comm
+        ksp = make_ksp(comm, options, prefix)
+        entry = {"mat": mat, "ksp": ksp, "values": None}
+        if wants_cudss(options):
+            from cudolfinx import cudss
+            entry["cudss"] = cudss.attach(ksp, mat, **cudss.options_kwargs(options))
+        _OPERATORS[key] = entry
+    mat = entry["mat"]
+    assembler().assemble_matrix(cf, mat, bcs=pack_bcs(bcs) if bcs else [])
+    mat.assemble()
+    mat.mat.assemble()
+    entry["ksp"].setOperators(mat.mat)              # new values: PETSc rebuilds the PC on next solve
+    entry["values"] = coefficient_values(form, bcs)
+    STATS["gpu_matrix_assemblies"] += 1
+    return mat.mat, entry["ksp"], False
+
+
+def is_symmetric(A: PETSc.Mat, rtol: float = 1e-10) -> bool:
+    """A == A^T up to rtol, tested on the device with two fixed pseudo-random vectors:
+    |A x - A^T x| <= rtol |A x|. (No host copy of the matrix; PETSc's own test reads the host
+    arrays of an AIJ matrix.) A matrix that fails to be symmetric only below rtol is treated as
+    symmetric, which perturbs an adjoint solution by a relative amount of that order."""
+    x, y = A.createVecs()
+    z = y.duplicate()
+    rng = np.random.RandomState(12345)
+    ok = True
+    for _ in range(2):
+        x.setArray(rng.rand(x.getLocalSize()) - 0.5)
+        A.mult(x, y)
+        A.multTranspose(x, z)
+        ny = y.norm()
+        z.axpy(-1.0, y)
+        if z.norm() > rtol * max(ny, 1e-300):
+            ok = False
+            break
+    for v in (x, y, z):
+        v.destroy()
+    return ok
+
+
+def assemble_scalar(form: ufl.Form, jit_options=None) -> float:
+    cf = cuda_form(form, jit_options)
+    local = assembler().assemble_scalar(cf)
+    comm = form.ufl_domain().ufl_cargo().comm
+    return comm.allreduce(local, op=_MPI().SUM)
+
+
+def make_ksp(comm, options: dict | None, prefix: str) -> PETSc.KSP:
+    ksp = PETSc.KSP().create(comm)
+    ksp.setOptionsPrefix(prefix)
+    opts = PETSc.Options()
+    opts.prefixPush(prefix)
+    for k, v in (options or {}).items():
+        if (k == "pc_type" and v == "cudss") or k.startswith("pc_cudss_"):   # cudolfinx.cudss, not PETSc
+            continue
+        opts[k] = v
+    opts.prefixPop()
+    ksp.setFromOptions()
+    return ksp
+
+
+def wants_cudss(options: dict | None) -> bool:
+    return (options or {}).get("pc_type") == "cudss"
+
+
+_SOLVE_VECTORS: dict[int, tuple] = {}      # function space id -> (b, x) CUDA Vecs
+
+
+LAST_SOLUTION: list = [None]       # the CUDA Vec of the most recent adjoint solve (device copy of λ)
+
+
+def solve_on_gpu(ksp: PETSc.KSP, A: PETSc.Mat, rhs: np.ndarray, template: cufem.CUDAVector,
+                 transpose: bool = False) -> np.ndarray:
+    """Solve A x = rhs (or A^T x = rhs) with a PETSc KSP whose operator is already set; vectors
+    are CUDA Vecs (one pair per function space, reused by every adjoint solve)."""
+    key = id(getattr(template, "_adjoint_space", template))
+    pair = _SOLVE_VECTORS.get(key)
+    if pair is None or pair[0].getLocalSize() != rhs.size:
+        pair = (template.vector.duplicate(), template.vector.duplicate())
+        _SOLVE_VECTORS[key] = pair
+    b, x = pair
+    b.setArray(rhs)
+    if transpose:
+        ksp.solveTranspose(b, x)
+    else:
+        ksp.solve(b, x)
+    out = x.getArray(readonly=True).copy()
+    LAST_SOLUTION[0] = x
+    STATS["adjoint_solves"] += 1
+    return out
+
+
+# -----------------------------------------------------------------------------
+# swapping checkpointed values into the live Function / Constant objects
+# -----------------------------------------------------------------------------
+@contextlib.contextmanager
+def substituted(values: dict):
+    """Temporarily write `values` (numpy arrays) into live Functions / Constants.
+
+    cuDOLFINx compiles a form against specific coefficient objects, so the adjoint of a
+    recorded solve is evaluated by giving those objects their saved values for the
+    duration of the assembly, then restoring whatever they held."""
+    saved = []
+    for obj, val in values.items():
+        if isinstance(obj, fem.Function):
+            if obj.x.array.shape == np.shape(val) and np.array_equal(obj.x.array, val):
+                continue                      # already holds the saved values (e.g. the velocity
+            saved.append((obj, obj.x.array.copy()))   # field of every step of a time loop):
+            obj.x.array[:] = val                      # no save / write / restore
+        else:
+            if np.array_equal(np.asarray(obj.value), np.asarray(val).reshape(np.shape(obj.value))):
+                continue
+            saved.append((obj, np.array(obj.value, copy=True)))
+            obj.value = np.asarray(val).reshape(np.shape(obj.value))
+    try:
+        yield
+    finally:
+        for obj, val in saved:
+            if isinstance(obj, fem.Function):
+                obj.x.array[:] = val
+            else:
+                obj.value = val
+
+
+# -----------------------------------------------------------------------------
+# derivatives with respect to Constants: a piecewise-constant (DG0) stand-in
+# -----------------------------------------------------------------------------
+# UFL cannot differentiate with respect to a Constant, and DOLFINx 0.10 cannot build a
+# function space on basix's "real" element. A Constant c is therefore replaced by a DG0
+# Function with the same value in every cell; d(form)/d(c) is the sum over the cells of
+# d(form)/d(f_DG0), assembled on the GPU like every other vector.
+_DG0: dict[tuple, tuple] = {}
+
+
+def constant_stand_in(c: fem.Constant, mesh):
+    """(DG0 Function holding c's value in every cell) for differentiating w.r.t. c."""
+    shape = tuple(np.shape(c.value))
+    key = (id(c), id(mesh))
+    hit = _DG0.get(key)
+    if hit is None:
+        el = basix.ufl.element("DG", mesh.basix_cell(), 0, shape=shape)
+        V = fem.functionspace(mesh, el)
+        f = fem.Function(V)
+        hit = (V, f, c)
+        _DG0[key] = hit
+    V, f, _ = hit
+    f.x.array[:] = np.tile(np.asarray(c.value).ravel(), f.x.array.size // max(1, int(np.prod(shape)) or 1))
+    return f
+
+
+def constant_derivative(form: ufl.Form, c: fem.Constant, mesh, jit_options=None, device_values=None) -> np.ndarray:
+    """d(form)/dc for a rank-0 form, shaped like c.value."""
+    f = constant_stand_in(c, mesh)
+    dF = derived(form, ("d_constant", id(c)), lambda: ufl.derivative(
+        ufl.replace(form, {c: f}), f, ufl.TestFunction(f.function_space)))
+    try:
+        from . import affine
+        vec = affine.assemble_vector(dF, jit_options, device_values)   # GPU (SpMV once the matrix exists)
+    except Exception:
+        v = fem.assemble_vector(fem.form(dF))                      # CPU fallback
+        v.scatter_reverse(_la_add())
+        vec = np.array(v.array[:owned(f.function_space)])
+        STATS["cpu_constant_derivatives"] += 1
+    STATS["constant_derivatives"] += 1
+    ncomp = max(1, int(np.prod(np.shape(c.value))) or 1)
+    comm = mesh.comm
+    total = comm.allreduce(vec.reshape(-1, ncomp).sum(axis=0), op=_MPI().SUM)
+    return np.asarray(total).reshape(np.shape(c.value))
+
+
+def _la_add():
+    from dolfinx import la
+    return la.InsertMode.add
+
+
+def _MPI():
+    from mpi4py import MPI
+    return MPI
+
+
+def owned(V) -> int:
+    im = V.dofmap.index_map
+    return im.size_local * V.dofmap.index_map_bs
+
+
+def clear():
+    """Drop every cached GPU object (compiled forms, matrices, adjoint operators and their
+    factorisations, work vectors). Call it between independent problems - e.g. at the start of
+    every epoch of an optimisation that rebuilds its forms on new Functions - or the caches,
+    keyed by coefficient identity, grow with every epoch until the GPU runs out of memory."""
+    import gc
+    from . import affine, timeloop
+    affine.clear()
+    timeloop.clear()
+    # PETSc matrices are released by the CUDAMatrix wrappers when they are garbage collected
+    # (an explicit MatDestroy here double-frees with the C++ destructor); KSPs and own vectors
+    # can be destroyed directly.
+    for entry in _OPERATORS.values():
+        try:
+            entry["ksp"].destroy()
+        except Exception:
+            pass
+    for b, x in _SOLVE_VECTORS.values():
+        try:
+            b.destroy(); x.destroy()
+        except Exception:
+            pass
+    for d in (_FORMS, _VECTORS, _MATRICES, _BCS, _FUNCTIONS, _DG0, _OPERATORS, _SOLVE_VECTORS, _DERIVED):
+        d.clear()
+    LAST_SOLUTION[0] = None
+    gc.collect()
diff --git a/python/cudolfinx/adjoint/solving.py b/python/cudolfinx/adjoint/solving.py
new file mode 100644
index 0000000..2ffa87f
--- /dev/null
+++ b/python/cudolfinx/adjoint/solving.py
@@ -0,0 +1,435 @@
+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""GPU linear / nonlinear problems that record themselves on the pyadjoint tape.
+
+Forward solve, adjoint solve and the assembly of every gradient contribution run through
+the cuDOLFINx assembler (GPU) and PETSc's CUDA solvers. The only CPU work is the
+derivative with respect to Constants (a handful of entries, see gpu.constant_derivative).
+
+For a recorded solve F(u; m_1, m_2, ...) = 0 with Dirichlet conditions u = g_k on Γ_k the
+block computes, given the adjoint input dJ/du:
+
+    (∂F/∂u)ᵀ λ = dJ/du          with λ = 0 on Dirichlet dofs
+    dJ/dm_i  = -(∂F/∂m_i)ᵀ λ       (assembled as action(adjoint(∂F/∂m_i), λ))
+    dJ/dg_k  = [dJ/du - (∂F/∂u)ᵀ λ] restricted to the dofs of Γ_k   (lifting sensitivity)
+
+which is the discrete adjoint used by dolfin-adjoint.
+"""
+
+from __future__ import annotations
+
+import typing
+
+import numpy as np
+from petsc4py import PETSc
+
+import ufl
+from dolfinx import fem
+from pyadjoint import Block
+from pyadjoint.tape import annotate_tape, get_working_tape, stop_annotating
+
+import cudolfinx as cufem
+from cudolfinx.la import CUDAVector
+
+from . import affine, gpu
+from .types import Constant, Function, from_cpp
+
+_DEFAULT_ADJOINT_OPTIONS = {"ksp_type": "gmres", "pc_type": "gamg", "ksp_rtol": 1e-12,
+                            "ksp_max_it": 2000}
+_counter = [0]
+
+
+def _prefix(base: str) -> str:
+    _counter[0] += 1
+    return f"{base}{_counter[0]}_"
+
+
+def _overloaded_coefficients(forms: typing.Iterable[ufl.Form]):
+    """Overloaded Functions and Constants the forms depend on (UFL lists Constants apart)."""
+    out = []
+    for f in forms:
+        for c in tuple(f.coefficients()) + tuple(f.constants()):
+            if isinstance(c, (Function, Constant)) and c not in out:
+                out.append(c)
+    return out
+
+
+def _bc_value(bc):
+    """The overloaded Function used as this condition's value, or None (bc.g is the C++ object)."""
+    g = bc.g
+    if isinstance(g, Function):
+        return g
+    return from_cpp(g)
+
+
+def _bc_controls(bcs):
+    """Overloaded Functions used as Dirichlet values."""
+    out = []
+    for bc in bcs:
+        g = _bc_value(bc)
+        if g is not None and g not in out:
+            out.append(g)
+    return out
+
+
+class SolveBlock(Block):
+    """Tape record of one GPU solve."""
+
+    def __init__(self, problem, F: ufl.Form, u: Function, bcs, linear: bool, ad_block_tag=None):
+        super().__init__(ad_block_tag=ad_block_tag)
+        self.problem = problem
+        self.F = F                                   # residual form (action(a, u) - L for linear)
+        self.u = u
+        self.bcs = list(bcs)
+        self.linear = linear
+        self.V = u.function_space
+        for c in _overloaded_coefficients([F]):
+            if linear and c is u:
+                continue
+            self.add_dependency(c, no_duplicates=True)
+        for g in _bc_controls(self.bcs):
+            self.add_dependency(g, no_duplicates=True)
+        if not linear:
+            # the initial guess is a dependency of the nonlinear solve (no derivative)
+            self.add_dependency(u, no_duplicates=True)
+        self.add_output(u.create_block_variable())
+        # derived UFL forms (∂F/∂u adjoint, ∂F/∂m, ...) are identical for every block recorded by
+        # the same problem (same F, same coefficient objects): build and sign them once
+        self._forms = problem.__dict__.setdefault("_adjoint_forms", {})
+
+    def _derived(self, key, build):
+        f = self._forms.get(key)
+        if f is None:
+            f = build()
+            self._forms[key] = f
+        return f
+
+    # ------------------------------------------------------------------ helpers
+    def _values(self, inputs):
+        """{live object: saved numpy values} for the dependencies and the output."""
+        vals = {}
+        for bv, inp in zip(self.get_dependencies(), inputs):
+            obj = bv.output
+            if isinstance(obj, fem.Function):
+                vals[obj] = inp.x.array if isinstance(inp, fem.Function) else np.asarray(inp)
+            else:
+                vals[obj] = inp.value if isinstance(inp, fem.Constant) else np.asarray(inp)
+        out = self.get_outputs()[0].saved_output
+        vals[self.u] = out.x.array if isinstance(out, fem.Function) else np.asarray(out)
+        return vals
+
+    def _bc_dofs(self) -> np.ndarray:
+        cache = self.problem.__dict__.setdefault("_adjoint_bc_dofs", {})
+        key = tuple(id(bc) for bc in self.bcs)
+        d = cache.get(key)
+        if d is None:
+            d = np.zeros(0, dtype=np.int32) if not self.bcs else \
+                np.unique(np.concatenate([bc.dof_indices()[0] for bc in self.bcs]))
+            cache[key] = d
+        return d
+
+    # ------------------------------------------------------------------ adjoint
+    def prepare_evaluate_adj(self, inputs, adj_inputs, relevant_dependencies):
+        adj_input = adj_inputs[0]
+        rhs = np.array(adj_input.x.array if isinstance(adj_input, fem.Function) else adj_input,
+                       dtype=np.float64)
+        values = self._values(inputs)
+        n_owned = gpu.owned(self.V)
+        lam_f = gpu.work_function(self.V)            # same object for every block of this space:
+        with gpu.substituted(values):                #   the forms built on it are compiled once
+            dFdu_adj = self._derived("dFdu_adj",
+                                     lambda: ufl.adjoint(ufl.derivative(self.F, self.u, ufl.TrialFunction(self.V))))
+            bc_dofs = self._bc_dofs()
+            rhs_hom = rhs[:n_owned].copy()
+            rhs_hom[bc_dofs[bc_dofs < n_owned]] = 0.0
+            fwd = self.problem.adjoint_solver() if (self.linear and gpu.CONFIG["reuse_forward_operator"]) else None
+            if fwd is not None:
+                # the forward matrix (as assembled now) is the adjoint operator or its transpose:
+                # no second assembly, no second preconditioner / factorisation
+                ksp, transpose = fwd
+                lam = gpu.solve_on_gpu(ksp, None, rhs_hom, self.problem.b, transpose=transpose)
+                gpu.STATS["forward_operator_reused"] += 1
+            else:
+                A, ksp, reused = gpu.adjoint_operator(dFdu_adj, self.bcs, self.problem.adjoint_options,
+                                                      self.problem.adjoint_prefix, self.problem.jit_options)
+                if reused:
+                    gpu.STATS["adjoint_operator_reused"] += 1
+                lam = gpu.solve_on_gpu(ksp, A, rhs_hom,
+                                       gpu.work_vector(gpu.cuda_form(dFdu_adj, self.problem.jit_options)))
+            lam_f.x.array[:n_owned] = lam
+            lam_f.x.scatter_forward()
+            lam_dev = {id(lam_f): gpu.LAST_SOLUTION[0]}          # λ is already on the device
+            adj_bdy = None
+            if _bc_controls(self.bcs):
+                # dJ/du - (∂F/∂u)ᵀ λ, with the unmodified operator: the lifting sensitivity
+                full = affine.assemble_vector(self._derived("dFdu_adj_lam", lambda: ufl.action(dFdu_adj, lam_f)),
+                                              self.problem.jit_options, lam_dev)
+                adj_bdy = rhs[:n_owned] - full
+        return {"values": values, "lam": lam_f, "lam_values": lam_f.x.array.copy(), "adj_bdy": adj_bdy,
+                "lam_dev": lam_dev}
+
+    def evaluate_adj_component(self, inputs, adj_inputs, block_variable, idx, prepared=None):
+        c = block_variable.output
+        values, lam = prepared["values"], prepared["lam"]
+        lam.x.array[:] = prepared["lam_values"]           # shared work Function: restore this block's λ
+        if c is self.u and not self.linear:
+            return None                                       # no derivative w.r.t. the initial guess
+        is_bc_value = any(_bc_value(bc) is c for bc in self.bcs)
+        if isinstance(c, Function) and is_bc_value and c not in self.F.coefficients():
+            return self._bc_gradient(c, prepared["adj_bdy"])
+        with gpu.substituted(values):
+            if isinstance(c, Function):
+                form = self._derived(("dFdm_adj_lam", id(c)), lambda: ufl.action(
+                    ufl.adjoint(ufl.derivative(self.F, c, ufl.TrialFunction(c.function_space))), lam))
+                grad = -affine.assemble_vector(form, self.problem.jit_options, prepared.get("lam_dev"))
+                if is_bc_value:                                 # used both in F and as a bc value
+                    grad = grad + self._bc_gradient(c, prepared["adj_bdy"])
+                return grad
+            if isinstance(c, Constant):
+                pairing = self._derived("pairing", lambda: ufl.action(self.F, lam))   # λᵀ F(u, c): rank-0
+                mesh = self.V.mesh
+                return -gpu.constant_derivative(pairing, c, mesh, device_values=prepared.get("lam_dev"))
+        return None
+
+    def _bc_gradient(self, g: Function, adj_bdy: np.ndarray) -> np.ndarray:
+        """Entries of adj_bdy at the dofs constrained by the conditions using g, mapped into
+        g's function space (same space as u, or a collapsed sub-space)."""
+        out = np.zeros(gpu.owned(g.function_space))
+        n_owned = gpu.owned(self.V)
+        maps = self.problem.__dict__.setdefault("_adjoint_bc_maps", {})
+        for bc in self.bcs:
+            if _bc_value(bc) is not g:
+                continue
+            m = maps.get(id(bc))
+            if m is None:
+                dofs, _ = bc.dof_indices()
+                dofs = dofs[dofs < n_owned]
+                Vbc = bc.function_space
+                if Vbc.contains(g.function_space._cpp_object) and \
+                        Vbc.dofmap.index_map.size_local * Vbc.dofmap.index_map_bs == out.size:
+                    m = (dofs, dofs)
+                else:                                       # g lives in the collapsed sub-space
+                    _, parent = Vbc.collapse()
+                    pos = np.full(n_owned, -1, dtype=np.int64)
+                    pos[np.asarray(parent)] = np.arange(len(parent))
+                    keep = pos[dofs] >= 0
+                    m = (dofs[keep], pos[dofs[keep]])
+                maps[id(bc)] = m
+            src, dst = m
+            np.add.at(out, dst, adj_bdy[src])
+        return out
+
+    # ------------------------------------------------------------------ replay
+    def prepare_recompute_component(self, inputs, relevant_outputs):
+        return self._values(inputs)
+
+    def recompute_component(self, inputs, block_variable, idx, prepared):
+        # The saved inputs are written into the live objects only for the duration of the
+        # solve; afterwards every live object (including u) holds what it held before, so a
+        # recompute never changes what the user sees (pyadjoint keeps the result as a checkpoint).
+        with gpu.substituted(prepared):
+            with stop_annotating():
+                self.problem.solve()
+            return self.u._ad_copy()
+
+
+class LinearProblem:
+    """Solve a(u, v) = L(v) on the GPU with cuDOLFINx assembly and a PETSc (CUDA) KSP, and
+    record the solve on the pyadjoint tape.
+
+    Args:
+        a, L: bilinear and linear UFL forms.
+        u: the solution Function (an :class:`cudolfinx.adjoint.Function`).
+        bcs: Dirichlet conditions.
+        petsc_options: KSP options for the forward solve.
+        adjoint_petsc_options: KSP options for the adjoint solves (default: GMRES + GAMG).
+        constant_matrix: assemble the matrix only once (its coefficients never change).
+        cuda_jit_options: passed to the CUDA JIT compiler.
+    """
+
+    def __init__(self, a: ufl.Form, L: ufl.Form, u: Function, bcs=None, *, petsc_options: dict | None = None,
+                 adjoint_petsc_options: dict | None = None, constant_matrix: bool = False,
+                 petsc_options_prefix: str | None = None, cuda_jit_options: dict | None = None):
+        if not isinstance(u, Function):
+            raise TypeError("u must be a cudolfinx.adjoint.Function")
+        self.a, self.L, self.u = a, L, u
+        self.bcs = list(bcs or [])
+        self.jit_options = cuda_jit_options or {}
+        self.constant_matrix = constant_matrix
+        self._matrix_values = None                   # coefficient values the matrix was built from
+        self.asm = gpu.assembler()
+        self.cuda_a = gpu.cuda_form(a, self.jit_options)
+        self.cuda_L = gpu.cuda_form(L, self.jit_options)
+        self._affine_L = affine.affine_form(L, self.jit_options)
+        self.A = self.asm.create_matrix(self.cuda_a)
+        self.b = self.asm.create_vector(self.cuda_L)
+        self.x = self.b.vector.duplicate()
+        self.device_bcs = gpu.pack_bcs(self.bcs) if self.bcs else []
+        comm = u.function_space.mesh.comm
+        self.ksp = gpu.make_ksp(comm, petsc_options, petsc_options_prefix or _prefix("cuadj_linear_"))
+        if gpu.wants_cudss(petsc_options):
+            from cudolfinx import cudss
+            self._cudss = cudss.attach(self.ksp, self.A, **cudss.options_kwargs(petsc_options))
+        self.adjoint_options = adjoint_petsc_options or petsc_options or _DEFAULT_ADJOINT_OPTIONS
+        self.adjoint_prefix = _prefix("cuadj_linear_adjoint_")
+        # the adjoint may be solved with the forward operator only if no separate adjoint
+        # solver was asked for
+        self._own_adjoint_solver = adjoint_petsc_options is not None and adjoint_petsc_options != petsc_options
+        opts = petsc_options or {}
+        self._petsc_lu = opts.get("ksp_type") == "preonly" and opts.get("pc_type") == "lu"
+        self._symmetric = (None, False)              # (matrix state, result of the symmetry probe)
+        # residual form of the solve (what the adjoint differentiates)
+        self.F = ufl.action(a, u) - L
+
+    def solve(self, annotate=None) -> Function:
+        annotate = annotate_tape({"annotate": annotate} if annotate is not None else None)
+        if annotate:
+            block = SolveBlock(self, self.F, self.u, self.bcs, linear=True)
+            get_working_tape().add_block(block)
+        self._forward()
+        return self.u
+
+    def _ensure_matrix(self):
+        # constant_matrix is a hint guarded by a cheap value comparison: a tape replay with a
+        # perturbed upstream coefficient (Taylor test, optimisation step) still gets the matrix
+        # that belongs to the current values, and an unchanged loop pays no assembly.
+        if not (self.constant_matrix and gpu.coefficient_values_unchanged(self._matrix_values, self.a, self.bcs)):
+            self.asm.assemble_matrix(self.cuda_a, self.A, bcs=self.device_bcs)
+            self.A.assemble()
+            self.A.mat.assemble()
+            self.ksp.setOperators(self.A.mat)
+            self._matrix_values = gpu.coefficient_values(self.a, self.bcs)
+
+    def _forward(self):
+        self._ensure_matrix()
+        if not (gpu.CONFIG["affine_replay"] and self._affine_L.replay(self.b.vector)):
+            self.asm.assemble_vector(self.cuda_L, self.b)
+            if gpu.CONFIG["affine_replay"]:
+                self._affine_L.learn(self.b.vector)        # remember these values for the replay
+        if self.bcs:
+            self.device_bcs.update()
+            if gpu.bc_values_zero(self.bcs):             # homogeneous conditions: no lifting
+                gpu.STATS["liftings_skipped"] += 1
+            else:
+                self.asm.apply_lifting(self.b, [self.cuda_a], [self.device_bcs])
+            self.asm.set_bc(self.b, bcs=self.device_bcs, V=self.u.function_space)
+        self.ksp.solve(self.b.vector, self.x)
+        n = gpu.owned(self.u.function_space)
+        self.u.x.array[:n] = self.x.getArray(readonly=True)
+        self.u.x.scatter_forward()
+
+
+    def adjoint_solver(self):
+        """``(ksp, transpose)`` that solves the adjoint system with the forward operator as it is
+        assembled now, or ``None`` if a separate adjoint operator is needed.
+
+        The adjoint operator is the transpose of the forward matrix (same Dirichlet rows and
+        columns). The forward matrix and its preconditioner / factorisation can therefore be
+        used when (1) the matrix was assembled from the coefficient values that are live now
+        (single solves; time loops whose operator does not change), and (2) the matrix is
+        symmetric (``ksp.solve``; any solver) or it is factorised by PETSc (``pc_type lu``:
+        ``ksp.solveTranspose``). cuDSS has no transposed solve, so a non-symmetric matrix
+        factorised by cuDSS gets its own adjoint factorisation."""
+        if self._own_adjoint_solver or self._matrix_values is None:
+            return None
+        if not gpu.coefficient_values_unchanged(self._matrix_values, self.a, self.bcs):
+            return None
+        state = self.A.mat.stateGet()
+        if self._symmetric[0] != state:
+            self._symmetric = (state, gpu.is_symmetric(self.A.mat))
+        if self._symmetric[1]:
+            return self.ksp, False
+        if self._petsc_lu:
+            return self.ksp, True
+        return None
+
+
+class NonlinearProblem:
+    """Solve F(u; v) = 0 with Newton's method on the GPU (cuDOLFINx assembly of residual and
+    Jacobian, PETSc CUDA KSP for the Newton steps) and record the solve on the tape.
+
+    Args:
+        F: residual form. J: Jacobian form (default derivative(F, u)).
+        u: solution / initial guess (:class:`cudolfinx.adjoint.Function`).
+        bcs: Dirichlet conditions.
+        petsc_options: KSP options for the linear solves inside Newton.
+        newton_options: dict with rtol (1e-9), atol (1e-10), max_it (50), relaxation (1.0),
+            report (False).
+        adjoint_petsc_options: KSP options for the adjoint solves.
+    """
+
+    def __init__(self, F: ufl.Form, u: Function, bcs=None, J: ufl.Form | None = None, *,
+                 petsc_options: dict | None = None, newton_options: dict | None = None,
+                 adjoint_petsc_options: dict | None = None, petsc_options_prefix: str | None = None,
+                 cuda_jit_options: dict | None = None):
+        if not isinstance(u, Function):
+            raise TypeError("u must be a cudolfinx.adjoint.Function")
+        self.F, self.u = F, u
+        self.J = J if J is not None else ufl.derivative(F, u, ufl.TrialFunction(u.function_space))
+        self.bcs = list(bcs or [])
+        self.jit_options = cuda_jit_options or {}
+        self.newton = {"rtol": 1e-9, "atol": 1e-10, "max_it": 50, "relaxation": 1.0, "report": False}
+        self.newton.update(newton_options or {})
+        self.asm = gpu.assembler()
+        self.cuda_F = gpu.cuda_form(F, self.jit_options)
+        self.cuda_J = gpu.cuda_form(self.J, self.jit_options)
+        self.A = self.asm.create_matrix(self.cuda_J)
+        self.b = self.asm.create_vector(self.cuda_F)
+        self.dx = self.b.vector.duplicate()
+        self.device_bcs = gpu.pack_bcs(self.bcs) if self.bcs else []
+        comm = u.function_space.mesh.comm
+        self.ksp = gpu.make_ksp(comm, petsc_options, petsc_options_prefix or _prefix("cuadj_newton_"))
+        if gpu.wants_cudss(petsc_options):
+            from cudolfinx import cudss
+            self._cudss = cudss.attach(self.ksp, self.A, **cudss.options_kwargs(petsc_options))
+        self.adjoint_options = adjoint_petsc_options or petsc_options or _DEFAULT_ADJOINT_OPTIONS
+        self.adjoint_prefix = _prefix("cuadj_newton_adjoint_")
+        self.iterations = 0
+        self._cuda_u = CUDAVector(self.asm._ctx, u.x.petsc_vec, include_ghosts=True)
+
+    def solve(self, annotate=None) -> Function:
+        annotate = annotate_tape({"annotate": annotate} if annotate is not None else None)
+        if annotate:
+            block = SolveBlock(self, self.F, self.u, self.bcs, linear=False)
+            get_working_tape().add_block(block)
+        self._forward()
+        return self.u
+
+    def _residual_norm(self) -> float:
+        """Assemble F(u) with the boundary rows replaced by (u - g) (DOLFINx's convention for
+        Newton residuals), on the GPU; returns its 2-norm."""
+        self._cuda_u.to_device()
+        self.asm.assemble_vector(self.cuda_F, self.b)
+        if self.bcs:
+            self.asm.apply_lifting(self.b, [self.cuda_J], [self.device_bcs], x0=[self._cuda_u], scale=-1.0)
+            self.asm.set_bc(self.b, bcs=self.device_bcs, V=self.u.function_space, x0=self._cuda_u, scale=-1.0)
+        return self.b.vector.norm()
+
+    def _forward(self):
+        u = self.u
+        n = gpu.owned(u.function_space)
+        if self.bcs:
+            self.device_bcs.update()
+        r0 = r = self._residual_norm()
+        it = 0
+        rtol, atol, maxit, relax = self.newton["rtol"], self.newton["atol"], self.newton["max_it"], self.newton["relaxation"]
+        if self.newton["report"]:
+            print(f"  Newton iteration 0: r (abs) = {r:.3e} r (rel) = 1.000e+00", flush=True)
+        while not (r < atol or (r0 > 0 and r / r0 < rtol)) and it < maxit:
+            self.asm.assemble_matrix(self.cuda_J, self.A, bcs=self.device_bcs)
+            self.A.assemble()
+            self.A.mat.assemble()
+            self.ksp.setOperators(self.A.mat)
+            self.ksp.solve(self.b.vector, self.dx)
+            u.x.array[:n] -= relax * self.dx.getArray(readonly=True)
+            u.x.scatter_forward()
+            it += 1
+            r = self._residual_norm()
+            if self.newton["report"]:
+                print(f"  Newton iteration {it}: r (abs) = {r:.3e} r (rel) = {r / r0 if r0 > 0 else 0:.3e}", flush=True)
+        self.iterations = it
+        if not (r < atol or (r0 > 0 and r / r0 < rtol)):
+            raise RuntimeError(f"Newton solver did not converge in {it} iterations (residual {r:.3e})")
