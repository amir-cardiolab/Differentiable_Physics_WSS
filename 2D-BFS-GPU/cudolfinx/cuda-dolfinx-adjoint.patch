+from dolfinx import fem
+from pyadjoint import AdjFloat, Block
+from pyadjoint.tape import annotate_tape, get_working_tape, stop_annotating
+
+from . import affine, gpu
+from .types import Constant, Function
+
+
+def assemble_scalar(form: ufl.Form, annotate=None, cuda_jit_options: dict | None = None) -> AdjFloat:
+    """Assemble a rank-0 form on the GPU (summed over MPI ranks) and record it."""
+    value = gpu.assemble_scalar(form, cuda_jit_options)
+    out = AdjFloat(value)
+    annotate = annotate_tape({"annotate": annotate} if annotate is not None else None)
+    if annotate:
+        block = AssembleBlock(form, cuda_jit_options)
+        get_working_tape().add_block(block)
+        block.add_output(out.block_variable)
+    return out
+
+
+class AssembleBlock(Block):
+    def __init__(self, form: ufl.Form, jit_options=None, ad_block_tag=None):
+        super().__init__(ad_block_tag=ad_block_tag)
+        self.form = form
+        self.jit_options = jit_options or {}
+        self.mesh = form.ufl_domain().ufl_cargo()
+        for c in tuple(form.coefficients()) + tuple(form.constants()):
+            if isinstance(c, (Function, Constant)):
+                self.add_dependency(c, no_duplicates=True)
+
+    def _values(self, inputs):
+        vals = {}
+        for bv, inp in zip(self.get_dependencies(), inputs):
+            obj = bv.output
+            if isinstance(obj, fem.Function):
+                vals[obj] = inp.x.array if isinstance(inp, fem.Function) else np.asarray(inp)
+            else:
+                vals[obj] = inp.value if isinstance(inp, fem.Constant) else np.asarray(inp)
+        return vals
+
+    def prepare_evaluate_adj(self, inputs, adj_inputs, relevant_dependencies):
+        return self._values(inputs)
+
+    def evaluate_adj_component(self, inputs, adj_inputs, block_variable, idx, prepared=None):
+        c = block_variable.output
+        w = float(adj_inputs[0])
+        with gpu.substituted(prepared):
+            if isinstance(c, Function):
+                dJ = gpu.derived(self.form, ("dJ", id(c)), lambda: ufl.derivative(
+                    self.form, c, ufl.TestFunction(c.function_space)))
+                return w * affine.assemble_vector(dJ, self.jit_options)
+            if isinstance(c, Constant):
+                return w * gpu.constant_derivative(self.form, c, self.mesh)
+        return None
+
+    def prepare_recompute_component(self, inputs, relevant_outputs):
+        return self._values(inputs)
+
+    def recompute_component(self, inputs, block_variable, idx, prepared):
+        with gpu.substituted(prepared):
+            return gpu.assemble_scalar(self.form, self.jit_options)
+
+
+def assign(target: Function, source, annotate=None) -> Function:
+    """target <- source (a Function on the same space, or an array / scalar), recorded on the
+    tape. Use this instead of ``target.x.array[:] = ...`` in annotated time loops (e.g.
+    ``assign(u_n, u)``), so the dependence of later steps on earlier ones is tracked."""
+    annotate = annotate_tape({"annotate": annotate} if annotate is not None else None)
+    if annotate:
+        block = AssignBlock(target, source)
+        get_working_tape().add_block(block)
+    with stop_annotating():
+        target.x.array[:] = source.x.array if isinstance(source, fem.Function) else source
+        target.x.scatter_forward()
+    if annotate:
+        block.add_output(target.create_block_variable())
+    return target
+
+
+class AssignBlock(Block):
+    def __init__(self, target, source, ad_block_tag=None):
+        super().__init__(ad_block_tag=ad_block_tag)
+        self.target = target
+        self.source_is_function = isinstance(source, Function)
+        if self.source_is_function:
+            self.add_dependency(source)
+        elif isinstance(source, fem.Function):        # a plain (not recorded) Function: data
+            self.source_value = source.x.array.copy()
+        else:
+            self.source_value = np.array(source, copy=True)
+
+    def evaluate_adj_component(self, inputs, adj_inputs, block_variable, idx, prepared=None):
+        if not self.source_is_function:
+            return None
+        adj = adj_inputs[0]
+        return np.array(adj.x.array if isinstance(adj, fem.Function) else adj, copy=True)
+
+    def recompute_component(self, inputs, block_variable, idx, prepared):
+        out = self.target._ad_init_zero()
+        out.x.array[:] = inputs[0].x.array if self.source_is_function else self.source_value
+        return out
