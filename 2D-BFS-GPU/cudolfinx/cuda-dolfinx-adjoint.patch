index 0000000..07e5978
--- /dev/null
+++ b/python/cudolfinx/adjoint/affine.py
@@ -0,0 +1,308 @@
+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""Affine replay of linear forms: a cell loop becomes a sparse matrix-vector product.
+
+Most vectors assembled in an inverse problem are affine in the coefficients that change
+between two assemblies: the right-hand side of a time step (linear in the previous state), the
+adjoint gradient contributions action(adjoint(∂F/∂m), λ) (linear in λ), the derivative of a
+quadratic functional. For such a form
+
+    L(c_1, ..., c_k; fixed) = Σ_i M_i c_i + b,      M_i = ∂L/∂c_i (a matrix), b = L(0)
+
+the matrices are assembled once (while the *fixed* coefficients keep their values) and every
+later evaluation is k sparse matrix-vector products on the GPU (cuSPARSE through PETSc), a few
+hundredths of a millisecond instead of a cell loop over the mesh.
+
+Which coefficients vary is learnt, not declared: a coefficient is promoted from "fixed" to
+"varying" the first time its values are seen to change, if the form is linear in it and has
+no product with another varying coefficient (checked symbolically with UFL). A change of a
+coefficient the form is not linear in, or of a Constant, invalidates the matrices (a "miss");
+a form that misses too often is assembled directly from then on.
+"""
+
+from __future__ import annotations
+
+import numpy as np
+from petsc4py import PETSc
+
+import ufl
+from ufl.algorithms import expand_derivatives
+from dolfinx import fem
+
+from . import gpu
+
+import os
+VERBOSE = os.environ.get("CUDOLFINX_ADJOINT_VERBOSE", "0") == "1"
+STATS = {"affine_forms": 0, "affine_replays": 0, "affine_matrices": 0, "affine_misses": 0,
+         "affine_disabled": 0, "affine_direct": 0}
+_FORMS: dict[tuple, "AffineForm"] = {}
+_VECS: dict[int, tuple] = {}            # function space id -> (space, CUDA work vector for SpMV input)
+
+
+def _is_zero_form(f) -> bool:
+    try:
+        f = expand_derivatives(f)
+    except Exception:
+        return False
+    if isinstance(f, ufl.form.ZeroBaseForm):
+        return True
+    return hasattr(f, "integrals") and len(f.integrals()) == 0
+
+
+def _cuda_vec(V, like: PETSc.Vec, slot=None) -> PETSc.Vec:
+    """A CUDA Vec with the owned size of V (one per (space, slot), reused). One vector per
+    coefficient (slot = its id) so that the SpMVs of one form never share an input vector."""
+    hit = _VECS.get((id(V), slot))
+    if hit is None:
+        n = gpu.owned(V)
+        if like.getLocalSize() == n:
+            v = like.duplicate()
+        else:
+            v = PETSc.Vec().create(V.mesh.comm)
+            v.setType(like.getType())
+            v.setSizes((n, None))
+            v.setUp()
+        hit = (V, v)                     # keep V alive: its id is the key
+        _VECS[(id(V), slot)] = hit
+    return hit[1]
+
+
+class AffineForm:
+    """One linear form, evaluated through matrices once its varying coefficients are known."""
+
+    def __init__(self, form: ufl.Form, jit_options=None):
+        self.form = form
+        self.jit = jit_options
+        self.cf = gpu.cuda_form(form, jit_options)
+        self.coeffs = [c for c in form.coefficients() if isinstance(c, fem.Function)]
+        self.consts = list(form.constants())
+        self.fixed_values: dict[int, np.ndarray] | None = None     # id(coeff) -> values at build
+        self.const_values: list[np.ndarray] = []
+        self.varying: dict[int, tuple] = {}                        # id(coeff) -> (coeff, CUDAMatrix, Mat, constant ids)
+        self.linear_ok: dict[int, bool] = {}
+        self.depends: dict[int, bool] = {}
+        self.b: PETSc.Vec | None = None
+        self.y: PETSc.Vec | None = None
+        self.tmp: PETSc.Vec | None = None
+        self.scratch: PETSc.Vec | None = None
+        self.uses = self.misses = 0
+        self.disabled = False
+        STATS["affine_forms"] += 1
+
+    # ------------------------------------------------------------------ symbolic checks
+    def _depends_on(self, c) -> bool:
+        """The form depends on c at all (∂L/∂c is not the zero form). UFL keeps a derivative of
+        a functional as one integral per original integral, so a derivative form carries
+        coefficients it does not depend on; their changes are irrelevant and a matrix for them
+        would be the (uncompilable) zero form."""
+        ok = self.depends.get(id(c))
+        if ok is None:
+            try:
+                ok = not _is_zero_form(ufl.derivative(self.form, c, ufl.TrialFunction(c.function_space)))
+            except Exception:
+                ok = True
+            self.depends[id(c)] = ok
+        return ok
+
+    def _linear_in(self, c) -> bool:
+        """The form is linear in c (its second derivative in c vanishes)."""
+        ok = self.linear_ok.get(id(c))
+        if ok is None:
+            try:
+                d1 = ufl.derivative(self.form, c, ufl.TrialFunction(c.function_space))
+                ok = _is_zero_form(ufl.derivative(d1, c, ufl.TrialFunction(c.function_space)))
+            except Exception:
+                ok = False
+            self.linear_ok[id(c)] = ok
+        return ok
+
+    def _independent(self, c, d) -> bool:
+        """No term of the form contains both c and d (∂²L/∂c∂d = 0)."""
+        try:
+            d1 = ufl.derivative(self.form, c, ufl.TrialFunction(c.function_space))
+            return _is_zero_form(ufl.derivative(d1, d, ufl.TrialFunction(d.function_space)))
+        except Exception:
+            return False
+
+    # ------------------------------------------------------------------ state
+    def _work(self):
+        if self.y is None:
+            wv = gpu.work_vector(self.cf).vector
+            self.y, self.b, self.tmp, self.scratch = wv.duplicate(), wv.duplicate(), wv.duplicate(), wv.duplicate()
+
+    def _snapshot(self):
+        self.fixed_values = {id(c): c.x.array.copy() for c in self.coeffs if id(c) not in self.varying}
+        self.const_values = [np.array(k.value, copy=True) for k in self.consts]
+
+    def _changed_fixed(self) -> list:
+        out = []
+        for c in self.coeffs:
+            if id(c) in self.varying or not self._depends_on(c):
+                continue
+            old = self.fixed_values.get(id(c))
+            if old is None or old.shape != c.x.array.shape or not np.array_equal(old, c.x.array):
+                out.append(c)
+        return out
+
+    def _consts_changed(self) -> bool:
+        return bool(self._changed_consts())
+
+    def _changed_consts(self) -> set:
+        return {id(k) for k, v in zip(self.consts, self.const_values) if not np.array_equal(np.asarray(k.value), v)}
+
+    def _build_matrix(self, c):
+        Mform = ufl.derivative(self.form, c, ufl.TrialFunction(c.function_space))
+        mat, pmat = gpu.assemble_matrix(Mform, [], self.jit)
+        STATS["affine_matrices"] += 1
+        consts = {id(k) for k in expand_derivatives(Mform).constants()}
+        return (c, mat, pmat, consts)
+
+    def _input_vec(self, c, device_values: dict | None) -> PETSc.Vec:
+        if device_values and id(c) in device_values:
+            return device_values[id(c)]
+        v = _cuda_vec(c.function_space, self.y, id(c))
+        v.setArray(c.x.array[:v.getLocalSize()])
+        return v
+
+    def _spmv_sum(self, device_values, into: PETSc.Vec):
+        """into = Σ_i M_i c_i (current values)."""
+        first = True
+        for c, mat, pmat, _ in self.varying.values():
+            x = self._input_vec(c, device_values)
+            if first:
+                pmat.mult(x, into)
+                first = False
+            else:
+                pmat.mult(x, self.scratch)      # never self.tmp: learn() may be holding the direct value there
+                into.axpy(1.0, self.scratch)
+        if first:
+            into.set(0.0)
+
+    def _disable(self):
+        self.disabled = True
+        STATS["affine_disabled"] += 1
+        self.varying.clear()
+
+    # ------------------------------------------------------------------ evaluation
+    def replay(self, into: PETSc.Vec, device_values: dict | None = None) -> bool:
+        """into = L(current values) through the matrices. False when a direct assembly is
+        needed first (first call, or a fixed coefficient changed): then assemble directly and
+        pass the result to learn()."""
+        if self.disabled or self.fixed_values is None or self._consts_changed() or self._changed_fixed():
+            return False
+        self._spmv_sum(device_values, into)
+        into.axpy(1.0, self.b)
+        self.uses += 1
+        STATS["affine_replays"] += 1
+        return True
+
+    def learn(self, full: PETSc.Vec):
+        """Record a directly assembled value `full` (a CUDA Vec) at the live coefficient values:
+        promotes the coefficients that changed since the last record, or rebuilds."""
+        if self.disabled:
+            return
+        self._work()
+        if self.fixed_values is None:
+            full.copy(self.b)
+            self._snapshot()
+            return
+        changed = self._changed_fixed()
+        others = [v[0] for v in self.varying.values()]
+        changed_consts = self._changed_consts()
+        valid = all(self._linear_in(c) for c in changed) and all(
+            self._independent(c, d) for c in changed for d in others + [e for e in changed if e is not c])
+        if valid and changed_consts:
+            # a Constant changed: the matrices that contain it are stale, the others are not;
+            # b is recomputed from the direct value below either way
+            STATS["affine_misses"] += 1
+            for cid, (c, mat, pmat, consts) in list(self.varying.items()):
+                if consts & changed_consts:
+                    self.varying[cid] = self._build_matrix(c)
+        if not valid and VERBOSE:
+            import sys
+            print("[affine] miss on form %s: changed %s, consts changed %s, linear %s" % (
+                self.form.signature()[:12], [getattr(c, "name", "?") for c in changed], self._consts_changed(),
+                [self._linear_in(c) for c in changed]), file=sys.stderr)
+        if not valid:
+            self.misses += 1
+            STATS["affine_misses"] += 1
+            if self.misses * 4 > self.uses + 4:
+                self._disable()
+                return
+            for cid, (c, mat, pmat, _) in list(self.varying.items()):       # matrices at the new values
+                self.varying[cid] = self._build_matrix(c)
+        else:
+            for c in changed:
+                try:
+                    self.varying[id(c)] = self._build_matrix(c)
+                except Exception as e:
+                    if VERBOSE:
+                        import sys, traceback
+                        print("[affine] giving up on form %s: matrix for %s failed: %s" % (
+                            self.form.signature()[:12], getattr(c, "name", c), e), file=sys.stderr)
+                        traceback.print_exc()
+                        try:
+                            Mform = ufl.derivative(self.form, c, ufl.TrialFunction(c.function_space))
+                            print("[affine]   expanded matrix form:", expand_derivatives(Mform), file=sys.stderr)
+                            fm = fem.form(Mform)
+                            print("[affine]   dolfinx form module:", fm.module.__file__, "integral types", fm.integral_types,
+                                  "rank", fm.rank, file=sys.stderr)
+                            print("[affine]   original form:", self.form, file=sys.stderr)
+                        except Exception as e2:
+                            print("[affine]   diagnostics failed:", e2, file=sys.stderr)
+                    self._disable()
+                    return
+        self._snapshot()
+        self._spmv_sum(None, self.y)
+        full.copy(self.b)
+        self.b.axpy(-1.0, self.y)                           # b = L(current) - Σ M_i c_i(current)
+
+    def assemble(self, device_values: dict | None = None) -> np.ndarray:
+        """Owned values of the form for the live coefficient values (host array).
+        `device_values` maps id(coefficient) -> CUDA Vec holding its values (saves a copy)."""
+        self._work()
+        if self.replay(self.y, device_values):
+            return self.y.getArray(readonly=True).copy()
+        STATS["affine_direct"] += 1
+        full = gpu.assemble_vector(self.form, self.jit)
+        if not self.disabled:
+            self.tmp.setArray(full)
+            self.learn(self.tmp)
+        return full
+
+
+def affine_form(form: ufl.Form, jit_options=None) -> AffineForm:
+    key = gpu._key(form)
+    af = _FORMS.get(key)
+    if af is None:
+        af = AffineForm(form, jit_options)
+        _FORMS[key] = af
+    return af
+
+
+def assemble_vector(form: ufl.Form, jit_options=None, device_values: dict | None = None) -> np.ndarray:
+    """Drop-in for gpu.assemble_vector with affine replay."""
+    if not gpu.CONFIG.get("affine_replay", True):
+        return gpu.assemble_vector(form, jit_options)
+    return affine_form(form, jit_options).assemble(device_values)
+
+
+def clear():
+    for af in _FORMS.values():
+        af.varying.clear()                     # matrices: released with their CUDAMatrix wrappers
+        for vec in (af.y, af.b, af.tmp, af.scratch):
+            if vec is not None:
+                try:
+                    vec.destroy()
+                except Exception:
+                    pass
+    for _, v in _VECS.values():
+        try:
+            v.destroy()
+        except Exception:
+            pass
+    _FORMS.clear()
+    _VECS.clear()
