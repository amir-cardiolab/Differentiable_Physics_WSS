+def _compute_capability() -> str:
+    """Compute capability of the device of the current CUDA context, e.g. "89" (or "unknown")."""
+    import ctypes
+    try:
+        cu = ctypes.CDLL("libcuda.so.1")
+        dev, major, minor = ctypes.c_int(), ctypes.c_int(), ctypes.c_int()
+        if cu.cuCtxGetDevice(ctypes.byref(dev)) != 0:
+            return "unknown"
+        # CU_DEVICE_ATTRIBUTE_COMPUTE_CAPABILITY_MAJOR / _MINOR
+        if cu.cuDeviceGetAttribute(ctypes.byref(major), 75, dev) != 0 or \
+                cu.cuDeviceGetAttribute(ctypes.byref(minor), 76, dev) != 0:
+            return "unknown"
+        return f"{major.value}{minor.value}"
+    except Exception:
+        return "unknown"
+
+
+def _kernel_cachedir(base: str) -> str:
+    """Cache directory of the compiled (PTX) kernels for the current GPU architecture.
+
+    The PTX of a kernel is specific to the compute capability it was compiled for (its
+    ``.target sm_XX`` line): a cache shared between machines with different GPUs (a cluster
+    home or scratch directory) must not hand an sm_90 kernel to an sm_89 device, which fails
+    with "ptxas fatal: SM version specified by .target is higher than default SM version"."""
+    d = Path(base) / ("cuda_sm" + _compute_capability())
+    d.mkdir(parents=True, exist_ok=True)
+    return str(d)
+
+
