+
+def _array(other):
+    return other.x.array if isinstance(other, fem.Function) else np.asarray(other)
+
+
+def _value(other):
+    return other.value if isinstance(other, fem.Constant) else np.asarray(other)
+
+
+def _MPI():
+    from mpi4py import MPI
+    return MPI
+
