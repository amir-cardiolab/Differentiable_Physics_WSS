diff --git a/python/cudolfinx/cudss.py b/python/cudolfinx/cudss.py
new file mode 100644
index 0000000..a534b28
--- /dev/null
+++ b/python/cudolfinx/cudss.py
@@ -0,0 +1,232 @@
+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""NVIDIA cuDSS (GPU sparse direct solver) as a PETSc preconditioner for cuDOLFINx matrices.
+
+PETSc in this environment has no cuDSS; this module binds libcudss with ctypes and plugs it
+into a PETSc KSP as a ``python`` preconditioner: ``preonly`` + exact LU on the GPU.
+
+    from cudolfinx import cudss
+    cudss.attach(ksp, cuda_matrix)        # cuda_matrix: cudolfinx.la.CUDAMatrix
+
+The factorisation is done once per matrix *values* (PETSc's object state is checked), so a
+time loop with a constant matrix pays one factorisation and then two triangular solves per
+step, entirely on the GPU; the right-hand side and solution never leave the device.
+
+Requires libcudss.so.0 (pip wheel ``nvidia-cudss-cu12``, or the directory in CUDSS_LIB_DIR).
+"""
+
+from __future__ import annotations
+
+import ctypes
+import glob
+import os
+
+import numpy as np
+from petsc4py import PETSc
+
+# enums from cudss_data_types.h (0.8) / library_types.h
+CUDA_R_32F, CUDA_R_64F, CUDA_R_32I = 0, 1, 10
+CUDSS_MTYPE_GENERAL, CUDSS_MVIEW_FULL, CUDSS_BASE_ZERO = 0, 0, 0
+MTYPES = {"general": 0, "symmetric": 1, "spd": 3}        # cudssMatrixType_t
+MVIEWS = {"full": 0, "lower": 1, "upper": 2}             # cudssMatrixViewType_t
+CUDSS_LAYOUT_COL_MAJOR = 0
+PHASE_ANALYSIS, PHASE_FACTORIZATION, PHASE_REFACTORIZATION = 3, 4, 8
+PHASE_SOLVE = (1 << 4) | (1 << 5) | (1 << 6) | (1 << 7) | (1 << 8) | (1 << 9)
+CONFIG_MATCHING_ALG = 3
+DATA_INFO = 0
+_STATUS = ["SUCCESS", "NOT_INITIALIZED", "ALLOC_FAILED", "INVALID_VALUE",
+           "NOT_SUPPORTED", "EXECUTION_FAILED", "INTERNAL_ERROR", "IR_FAILED"]
+
+_lib = None
+_cudart = None
+# diagnostics: refactorise at every PC set-up / apply regardless of the matrix state counter
+ALWAYS_REFACTOR = os.environ.get("CUDOLFINX_CUDSS_ALWAYS_REFACTOR", "0") == "1"
+
+
+def _find_lib():
+    cands = []
+    if os.environ.get("CUDSS_LIB_DIR"):
+        cands += glob.glob(os.path.join(os.environ["CUDSS_LIB_DIR"], "libcudss.so*"))
+    try:
+        import site
+        for d in site.getsitepackages() + [site.getusersitepackages()]:
+            cands += glob.glob(os.path.join(d, "nvidia", "*", "lib", "libcudss.so.0"))
+    except Exception:
+        pass
+    cands += glob.glob("/usr/lib/x86_64-linux-gnu/libcudss.so*") + glob.glob("/usr/local/lib/libcudss.so*")
+    for c in cands:
+        if os.path.exists(c):
+            return c
+    raise OSError("libcudss.so.0 not found (pip install nvidia-cudss-cu12 or set CUDSS_LIB_DIR)")
+
+
+def available() -> bool:
+    try:
+        _load()
+        return True
+    except OSError:
+        return False
+
+
+def _load():
+    global _lib, _cudart
+    if _lib is None:
+        _lib = ctypes.CDLL(_find_lib())
+        try:
+            _cudart = ctypes.CDLL("libcudart.so.12")
+        except OSError:
+            _cudart = None
+    return _lib
+
+
+def _check(status, what):
+    if status != 0:
+        raise RuntimeError("cuDSS %s failed: %s" % (what, _STATUS[status] if status < len(_STATUS) else status))
+
+
+def _sync():
+    if _cudart is not None:
+        _cudart.cudaDeviceSynchronize()
+
+
+class CuDSSFactor:
+    """LU factorisation of an int32-CSR fp64 matrix living on the GPU (raw device pointers)."""
+
+    def __init__(self, row_ptr: int, col_ind: int, values: int, n: int, nnz: int, matching: bool = True,
+                 mtype: str = "general", mview: str = "full"):
+        """mtype: "general" (LU with matching, any square matrix), "symmetric" (LDL^T) or
+        "spd" (Cholesky: about half the factorisation work and memory of LU). The symmetric
+        types read the triangle named by mview from the CSR arrays ("full": the whole matrix
+        is stored, as PETSc does)."""
+        lib = _load()
+        self.n, self.nnz = n, nnz
+        self.mtype = mtype
+        matching = matching and mtype == "general"
+        self.handle, self.config, self.data = ctypes.c_void_p(), ctypes.c_void_p(), ctypes.c_void_p()
+        _check(lib.cudssCreate(ctypes.byref(self.handle)), "create")
+        _check(lib.cudssConfigCreate(ctypes.byref(self.config)), "config")
+        _check(lib.cudssDataCreate(self.handle, ctypes.byref(self.data)), "data")
+        if matching:                     # max-product matching + scaling: robust for saddle points
+            v = ctypes.c_int(6)          # CUDSS_MATCHING_ALG_AUTO
+            _check(lib.cudssConfigSet(self.config, CONFIG_MATCHING_ALG, ctypes.byref(v), ctypes.sizeof(v)),
+                   "config matching")
+        self.A = ctypes.c_void_p()
+        _check(lib.cudssMatrixCreateCsr(
+            ctypes.byref(self.A), ctypes.c_int64(n), ctypes.c_int64(n), ctypes.c_int64(nnz),
+            ctypes.c_void_p(row_ptr), None, ctypes.c_void_p(col_ind), ctypes.c_void_p(values),
+            CUDA_R_32I, CUDA_R_32I, CUDA_R_64F, MTYPES[mtype], MVIEWS[mview], CUDSS_BASE_ZERO),
+            "matrix csr")
+        # dense descriptors are re-pointed at the PETSc vectors' device arrays in solve()
+        self.X, self.B = ctypes.c_void_p(), ctypes.c_void_p()
+        self._dummy = np.zeros(1)
+        for M in (self.X, self.B):
+            _check(lib.cudssMatrixCreateDn(ctypes.byref(M), ctypes.c_int64(n), ctypes.c_int64(1), ctypes.c_int64(n),
+                                           ctypes.c_void_p(values), CUDA_R_64F, CUDSS_LAYOUT_COL_MAJOR),
+                   "matrix dense")
+        _sync()
+        self._exec(PHASE_ANALYSIS, "analysis")
+        self.factored = False
+
+    def _exec(self, phase, what):
+        _check(_load().cudssExecute(self.handle, phase, self.config, self.data, self.A, self.X, self.B), what)
+
+    def factorize(self):
+        _sync()
+        self._exec(PHASE_REFACTORIZATION if self.factored else PHASE_FACTORIZATION, "factorization")
+        _sync()
+        v, w = ctypes.c_int(0), ctypes.c_size_t(0)
+        _check(_load().cudssDataGet(self.handle, self.data, DATA_INFO, ctypes.byref(v), ctypes.sizeof(v),
+                                    ctypes.byref(w)), "info")
+        if v.value != 0:
+            raise RuntimeError("cuDSS factorization info = %d (singular / zero pivot)" % v.value)
+        self.factored = True
+
+    def solve(self, b_dev: int, x_dev: int):
+        """Solve A x = b for device arrays (pointers) of length n."""
+        lib = _load()
+        _check(lib.cudssMatrixSetValues(self.B, ctypes.c_void_p(b_dev)), "set B")
+        _check(lib.cudssMatrixSetValues(self.X, ctypes.c_void_p(x_dev)), "set X")
+        _sync()
+        self._exec(PHASE_SOLVE, "solve")
+        _sync()
+
+    def __del__(self):
+        try:
+            lib = _load()
+            for M in (self.A, self.X, self.B):
+                lib.cudssMatrixDestroy(M)
+            lib.cudssDataDestroy(self.handle, self.data)
+            lib.cudssConfigDestroy(self.config)
+            lib.cudssDestroy(self.handle)
+        except Exception:
+            pass
+
+
+class CuDSSPC:
+    """petsc4py ``python`` preconditioner context: exact GPU LU of a cuDOLFINx CUDAMatrix."""
+
+    def __init__(self, cuda_matrix, mtype: str = "general", mview: str = "full"):
+        self.cuda_matrix = cuda_matrix
+        self.mtype, self.mview = mtype, mview
+        self.factor = None
+        self.state = None
+
+    def _refresh(self):
+        mat = self.cuda_matrix.mat
+        state = mat.stateGet()
+        if self.factor is None:
+            rp, ci, vals, n, m, nnz = self.cuda_matrix._cpp_object.device_csr()
+            if n != m:
+                raise ValueError("cuDSS LU needs a square matrix")
+            self.factor = CuDSSFactor(rp, ci, vals, n, nnz, mtype=self.mtype, mview=self.mview)
+            self.state = None
+        if self.state != state or ALWAYS_REFACTOR:   # new values (same pattern): refactorise
+            self.factor.factorize()
+            self.state = state
+
+    def setUp(self, pc):
+        self._refresh()
+
+    def apply(self, pc, x, y):
+        self._refresh()
+        xb = x.getCUDAHandle("r")
+        yb = y.getCUDAHandle("w")
+        try:
+            self.factor.solve(int(xb), int(yb))
+        finally:
+            x.restoreCUDAHandle(xb, "r")
+            y.restoreCUDAHandle(yb, "w")
+
+
+def attach(ksp: PETSc.KSP, cuda_matrix, mtype: str = "general", mview: str = "full") -> CuDSSPC:
+    """Make `ksp` an exact GPU direct solve (preonly + cuDSS) on `cuda_matrix`.
+
+    mtype "general" is LU and always applicable; "spd" (Cholesky) and "symmetric" (LDL^T) are
+    for matrices known to have that structure (the caller's responsibility)."""
+    ctx = CuDSSPC(cuda_matrix, mtype, mview)
+    ksp.setType("preonly")
+    pc = ksp.getPC()
+    pc.setType("python")
+    pc.setPythonContext(ctx)
+    ksp.setOperators(cuda_matrix.mat)
+    return ctx
+
+
+def options_kwargs(petsc_options: dict | None) -> dict:
+    """cuDSS settings carried in a PETSc-style options dict next to ``"pc_type": "cudss"``:
+    ``"pc_cudss_mtype"``: "general" (default, LU) | "symmetric" (LDL^T) | "spd" (Cholesky)."""
+    o = petsc_options or {}
+    kw = {}
+    if "pc_cudss_mtype" in o:
+        if o["pc_cudss_mtype"] not in MTYPES:
+            raise ValueError("pc_cudss_mtype must be one of %s" % sorted(MTYPES))
+        kw["mtype"] = o["pc_cudss_mtype"]
+    return kw
+
+
+def is_cudss_option(key: str, value=None) -> bool:
+    """True for the options handled here instead of by PETSc."""
+    return (key == "pc_type" and value == "cudss") or key.startswith("pc_cudss_")
