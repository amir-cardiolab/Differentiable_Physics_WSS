+# Copyright (C) 2026
+#
+# This file is part of cuDOLFINX
+#
+# SPDX-License-Identifier:    LGPL-3.0-or-later
+"""pyadjoint-overloaded DOLFINx types.
+
+``Function`` and ``Constant`` behave exactly like their DOLFINx counterparts; in addition
+they can be recorded on the pyadjoint tape as dependencies and outputs of GPU solves and
+functionals (see :mod:`cudolfinx.adjoint.solving`, :mod:`cudolfinx.adjoint.assembly`).
+
+Checkpoints are host-side copies (a Function / Constant copy), so the tape never holds GPU
+memory. Riesz representation of gradients is l2 (the dual vector
+is returned as a Function with the same dof values), which matches dolfin-adjoint's default.
+"""
+
+from __future__ import annotations
+
+import weakref
+
+import numpy as np
+
+from pyadjoint.overloaded_type import (
+    FloatingType,
+    OverloadedType,
+    create_overloaded_object,
+    register_overloaded_type,
+)
+
+from dolfinx import fem
+
+
+@register_overloaded_type
+class Function(fem.Function, FloatingType):
+    """A :class:`dolfinx.fem.Function` that pyadjoint can record.
+
+    The DOLFINx class is the first base on purpose: FFCx finds the code-generation handler of
+    a terminal by following ``type(t).__bases__[0]`` upwards."""
+
+    def __init__(self, *args, **kwargs):
+        # pyadjoint's OverloadedType does not chain to the next base class, so the
+        # DOLFINx constructor is called explicitly (as dolfin-adjoint does).
+        FloatingType.__init__(
+            self,
+            block_class=kwargs.pop("block_class", None),
+            _ad_floating_active=kwargs.pop("_ad_floating_active", False),
+            _ad_args=kwargs.pop("_ad_args", []),
+            output_block_class=kwargs.pop("output_block_class", None),
+            _ad_output_args=kwargs.pop("_ad_output_args", []),
+            _ad_outputs=kwargs.pop("_ad_outputs", []),
+        )
+        kwargs.pop("annotate", None)
+        fem.Function.__init__(self, *args, **kwargs)
+        # DOLFINx hands out the C++ object in places (e.g. DirichletBC.g); remember the wrapper
+        _CPP_TO_PY[id(self._cpp_object)] = weakref.ref(self)
+
+    # -- construction from a plain dolfinx Function -------------------------------
+    @classmethod
+    def _ad_init_object(cls, obj):
+        f = cls(obj.function_space, name=obj.name, dtype=obj.x.array.dtype)
+        f.x.array[:] = obj.x.array
+        return f
+
+    def _ad_init_object(self, obj):  # noqa: F811  (pyadjoint calls it on the instance with a dual value)
+        """Function from a dolfinx Function or from an array of dof values (an adjoint value)."""
+        if isinstance(obj, fem.Function):
+            f = Function(obj.function_space, name=obj.name, dtype=obj.x.array.dtype)
+            f.x.array[:] = obj.x.array
+            return f
+        f = Function(self.function_space, dtype=self.x.array.dtype)
+        n = min(f.x.array.size, np.asarray(obj).size)
+        f.x.array[:n] = np.asarray(obj).ravel()[:n]
+        f.x.scatter_forward()
+        return f
+
+    def copy(self, *, deepcopy: bool = True) -> Function:  # noqa: D102
+        f = Function(self.function_space, name=self.name, dtype=self.x.array.dtype)
+        f.x.array[:] = self.x.array
+        return f
+
+    # -- pyadjoint interface ---------------------------------------------------------
+    def _ad_will_add_as_dependency(self):
+        """Called when this Function becomes a block dependency. pyadjoint keeps an existing
+        checkpoint (overwrite=False); if the live values were changed in place since it was
+        taken (a control updated with g.x.array[:] = ... between two tapes, the usual
+        optimisation-loop pattern), the checkpoint is refreshed so that the tape records what
+        the forward solve actually used."""
+        FloatingType._ad_will_add_as_dependency(self)
+        bv = self.block_variable
+        ck = bv.checkpoint
+        if isinstance(ck, fem.Function) and ck is not self and (
+                ck.x.array.shape != self.x.array.shape or not np.array_equal(ck.x.array, self.x.array)):
+            bv._checkpoint = self._ad_create_checkpoint()
+            return True
+        return None
+
+    def _ad_init_zero(self, dual=False):
+        return Function(self.function_space, dtype=self.x.array.dtype)
+
+    def _ad_convert_riesz(self, value, riesz_map=None):
+        if value is None:
+            return self._ad_init_zero()
+        out = Function(self.function_space, dtype=self.x.array.dtype)
+        out.x.array[:] = np.asarray(value if not isinstance(value, fem.Function) else value.x.array)
+        return out
+
+    def _ad_create_checkpoint(self):
+        # pyadjoint stores whatever recompute_component returns as the checkpoint and hands it
+        # back through _ad_restore_at_checkpoint, so checkpoints are Functions (copies), as in
+        # dolfin-adjoint; the live object is never touched.
+        return self.copy()
+
+    def _ad_restore_at_checkpoint(self, checkpoint):
+        if isinstance(checkpoint, fem.Function):
+            return checkpoint
+        f = Function(self.function_space, name=self.name, dtype=self.x.array.dtype)
+        f.x.array[:] = checkpoint
+        return f
+
+    def _ad_mul(self, other):
+        out = self.copy()
+        out.x.array[:] *= other
+        return out
+
+    def _ad_imul(self, other):
+        self.x.array[:] *= other
+        return self
+
+    def _ad_add(self, other):
+        out = self.copy()
+        out.x.array[:] += _array(other)
+        return out
+
+    def _ad_iadd(self, other):
+        self.x.array[:] += _array(other)
+        return self
+
+    def _ad_dot(self, other, options=None):
+        comm = self.function_space.mesh.comm
+        n = self.x.index_map.size_local * self.x.block_size
+        local = float(np.dot(self.x.array[:n], _array(other)[:n]))
+        return comm.allreduce(local, op=_MPI().SUM)
+
+    @staticmethod
+    def _ad_assign_numpy(dst, src, offset):
+        n = dst.x.index_map.size_local * dst.x.block_size
+        dst.x.array[:n] = src[offset:offset + n]
+        dst.x.scatter_forward()
+        return dst, offset + n
+
+    @staticmethod
+    def _ad_to_list(m):
+        n = m.x.index_map.size_local * m.x.block_size
+        return m.x.array[:n].tolist()
+
+    def _ad_copy(self):
+        return self.copy()
+
+    def _ad_dim(self):
+        return self.x.index_map.size_global * self.x.block_size
+
+    def _ad_str(self):
+        return str(self.x.array)
+
+
+@register_overloaded_type
+class Constant(fem.Constant, OverloadedType):
+    """A :class:`dolfinx.fem.Constant` that pyadjoint can record."""
+
+    def __init__(self, domain, c, **kwargs):
+        OverloadedType.__init__(self)
+        fem.Constant.__init__(self, domain, c)
+
+    def _ad_init_object(self, obj):
+        """Constant from a Constant or from an array / scalar (an adjoint value)."""
+        if isinstance(obj, fem.Constant):
+            return Constant(obj.domain, np.array(obj.value, copy=True))
+        return Constant(self.domain, np.array(obj, dtype=self.value.dtype).reshape(self.value.shape))
+
+    def _ad_will_add_as_dependency(self):
+        OverloadedType._ad_will_add_as_dependency(self)
+        bv = self.block_variable
+        ck = bv.checkpoint
+        if isinstance(ck, fem.Constant) and ck is not self and not np.array_equal(np.asarray(ck.value), np.asarray(self.value)):
+            bv._checkpoint = self._ad_create_checkpoint()
+            return True
+        return None
+
+    def _ad_init_zero(self, dual=False):
+        return Constant(self.domain, np.zeros_like(self.value))
+
+    def _ad_convert_riesz(self, value, riesz_map=None):
+        if value is None:
+            return self._ad_init_zero()
+        return Constant(self.domain, np.array(value, dtype=self.value.dtype).reshape(self.value.shape))
+
+    def _ad_create_checkpoint(self):
+        return Constant(self.domain, np.array(self.value, copy=True))
+
+    def _ad_restore_at_checkpoint(self, checkpoint):
+        if isinstance(checkpoint, fem.Constant):
+            return checkpoint
+        return Constant(self.domain, np.array(checkpoint, copy=True))
+
+    def _ad_mul(self, other):
+        return Constant(self.domain, self.value * other)
+
+    def _ad_imul(self, other):
+        self.value = self.value * other
+        return self
+
+    def _ad_add(self, other):
+        return Constant(self.domain, self.value + _value(other))
+
+    def _ad_iadd(self, other):
+        self.value = self.value + _value(other)
+        return self
+
+    def _ad_dot(self, other, options=None):
+        return float(np.sum(self.value * _value(other)))
+
+    @staticmethod
+    def _ad_assign_numpy(dst, src, offset):
+        n = dst.value.size
+        dst.value = np.array(src[offset:offset + n]).reshape(dst.value.shape)
+        return dst, offset + n
+
+    @staticmethod
+    def _ad_to_list(m):
+        return np.asarray(m.value).ravel().tolist()
+
+    def _ad_copy(self):
+        return Constant(self.domain, np.array(self.value, copy=True))
+
+    def _ad_dim(self):
+        return int(np.asarray(self.value).size)
+
+    @property
+    def domain(self):
+        """The mesh (or UFL domain) the Constant was created on."""
+        return self._domain
+
+
+# dolfinx.fem.Constant does not keep the mesh it was created on; remember it so that
+# copies (checkpoints, zeros, Riesz representers) can be made.
+_orig_constant_init = fem.Constant.__init__
+
+
+def _constant_init(self, domain, c):
+    _orig_constant_init(self, domain, c)
+    self._domain = domain
+
+
+fem.Constant.__init__ = _constant_init
+
+
+_CPP_TO_PY: dict = {}
+
+
+def from_cpp(obj):
+    """The Python Function wrapping a C++ Function object (or None)."""
+    ref = _CPP_TO_PY.get(id(obj))
+    return ref() if ref is not None else None
